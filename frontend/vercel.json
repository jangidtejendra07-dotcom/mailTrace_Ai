{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mailtrace-ai-backend.onrender.com/api/:path*"
    },
    {
      "source": "/graphql",
      "destination": "https://mailtrace-ai-backend.onrender.com/graphql"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}